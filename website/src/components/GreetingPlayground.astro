---
import { Code } from 'astro:components';
import { functionDefinition } from '../lib/greeting-playground.mjs';
const codeTheme = {
  name: 'intpot-charcoal', type: 'dark' as const,
  colors: { 'editor.background': '#191a17', 'editor.foreground': '#eee9dc' },
  tokenColors: [
    { scope: ['keyword', 'storage', 'entity.name.function'], settings: { foreground: '#e8c477' } },
    { scope: ['string'], settings: { foreground: '#c8d3b4' } },
    { scope: ['comment'], settings: { foreground: '#acae9f' } },
    { scope: ['constant', 'support.type'], settings: { foreground: '#d7cba7' } },
  ],
};
---
<section class="workbench" aria-labelledby="playground-title" data-playground>
  <header class="workbench-head"><div><p class="kicker">INTPOT · PLAYGROUND</p><h1 id="playground-title">One definition. Three ways in.</h1></div><p class="boundary">Browser-local preview <span>·</span> Python adapters do not run here</p></header>
  <div class="definition" aria-label="Canonical typed Python definition"><div class="code-bar"><span>examples/semantic_schema.py</span><span>Python</span></div><Code code={functionDefinition} lang="python" theme={codeTheme} /></div>
  <div class="interface-nav" role="tablist" aria-label="Choose an interface"><button type="button" role="tab" id="tab-CLI" aria-controls="interface-panel" aria-selected="true" data-kind="CLI"><span>01</span> CLI <small>Typer</small></button><button type="button" role="tab" id="tab-HTTP" aria-controls="interface-panel" aria-selected="false" tabindex="-1" data-kind="HTTP"><span>02</span> HTTP <small>FastAPI</small></button><button type="button" role="tab" id="tab-MCP" aria-controls="interface-panel" aria-selected="false" tabindex="-1" data-kind="MCP"><span>03</span> MCP <small>FastMCP</small></button></div>
  <article class="request" id="interface-panel" role="tabpanel" aria-labelledby="tab-CLI"><div class="request-heading"><div><p class="kicker" id="interface-label">CLI · REQUEST</p><p class="request-caption" id="request-caption">A command passes a name and its typed options.</p></div><a href="https://github.com/tugrulguner/intpot/blob/main/examples/semantic_schema.py">Source ↗</a></div><label class="sr-only" for="request">Editable interface request</label><textarea id="request" maxlength="512" rows="3" spellcheck="false" aria-describedby="request-help"></textarea><div class="actions"><button type="button" class="run" id="run-request">Run local preview <span aria-hidden="true">↗</span></button><button type="button" class="reset" id="reset-request">Reset</button><span id="request-help">Edits never execute automatically.</span></div><p class="error" role="alert" aria-live="polite"></p><div class="result" aria-live="polite"><div><span class="result-label">TYPED ARGUMENTS</span><pre id="arguments">Not run</pre></div><div><span class="result-label">COMPUTED RESULT</span><pre id="computed">Not run</pre></div><div><span class="result-label">INTERFACE RESPONSE</span><pre id="response">Not run</pre></div><ol id="trace"><li>Choose a request and run its browser-local preview.</li></ol></div></article>
  <footer class="workbench-foot"><p>Runs a bounded JavaScript preview of request parsing and function behavior—not Python, Typer, FastAPI, FastMCP, a server, or a model.</p><nav aria-label="Intpot resources"><a href="/quickstart/">Run real Intpot locally →</a><a href="/capabilities/">Docs</a><a href="https://github.com/tugrulguner/intpot">GitHub ↗</a><a href="https://modepot.io/">ModePot ↗</a></nav></footer>
</section>
<script>
import { defaultRequests, runRequest } from '../lib/greeting-playground.mjs';
const root = document.querySelector<HTMLElement>('[data-playground]')!;
const input = root.querySelector<HTMLTextAreaElement>('#request')!;
const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
let active: 'CLI' | 'HTTP' | 'MCP' = 'CLI';
const defaults = defaultRequests(); input.value = defaults.CLI;
const clear = (message = 'Choose a request and run its browser-local preview.') => {
  root.querySelector<HTMLElement>('.error')!.textContent = '';
  for (const id of ['arguments', 'computed', 'response']) root.querySelector(`#${id}`)!.textContent = 'Not run';
  const li = document.createElement('li'); li.textContent = message;
  root.querySelector<HTMLOListElement>('#trace')!.replaceChildren(li);
};
const select = (kind: 'CLI' | 'HTTP' | 'MCP', focus = false) => {
  active = kind;
  tabs.forEach((tab) => { const selected = tab.dataset.kind === kind; tab.setAttribute('aria-selected', String(selected)); tab.tabIndex = selected ? 0 : -1; });
  const tab = root.querySelector<HTMLButtonElement>(`#tab-${kind}`)!;
  root.querySelector<HTMLElement>('#interface-panel')!.setAttribute('aria-labelledby', tab.id);
  root.querySelector<HTMLElement>('#interface-label')!.textContent = `${kind === 'HTTP' ? 'HTTP API' : kind} · REQUEST`;
  root.querySelector<HTMLElement>('#request-caption')!.textContent = kind === 'CLI' ? 'A command passes a name and its typed options.' : kind === 'HTTP' ? 'POST /greet sends a JSON request body.' : 'A greet tool call passes typed arguments.';
  input.value = defaults[kind]; clear(); if (focus) input.focus();
};
tabs.forEach((tab, index) => {
  tab.addEventListener('click', () => select(tab.dataset.kind as typeof active));
  tab.addEventListener('keydown', (event) => {
    if (!['ArrowRight', 'ArrowLeft', 'Home', 'End'].includes(event.key)) return;
    event.preventDefault(); const next = event.key === 'Home' ? 0 : event.key === 'End' ? 2 : (index + (event.key === 'ArrowRight' ? 1 : 2)) % 3;
    select(tabs[next].dataset.kind as typeof active, true); tabs[next].focus();
  });
});
input.addEventListener('input', () => clear('Request edited; run again to compute a fresh result.'));
root.querySelector<HTMLButtonElement>('#run-request')!.addEventListener('click', () => {
  clear();
  try {
    const output = runRequest(active, input.value);
    root.querySelector('#arguments')!.textContent = JSON.stringify(output.args);
    root.querySelector('#computed')!.textContent = output.result;
    root.querySelector('#response')!.textContent = typeof output.response === 'string' ? output.response : JSON.stringify(output.response, null, 2);
    root.querySelector<HTMLOListElement>('#trace')!.replaceChildren(...output.trace.map((line) => { const li = document.createElement('li'); li.textContent = line; return li; }));
  } catch (cause) { root.querySelector<HTMLElement>('.error')!.textContent = cause instanceof Error ? cause.message : 'Invalid request.'; }
});
root.querySelector<HTMLButtonElement>('#reset-request')!.addEventListener('click', () => { input.value = defaults[active]; clear(); });
</script>
<style>
.workbench{--wb-ink:var(--sl-color-text);--wb-muted:var(--sl-color-gray-2);--wb-line:var(--sl-color-gray-5);--wb-surface:var(--sl-color-bg);--wb-gold:var(--sl-color-accent);max-width:78rem;color:var(--wb-ink);font-size:var(--sl-text-sm)}
.workbench-head{display:flex;align-items:end;justify-content:space-between;gap:1rem;padding:0 0 1.15rem;border-bottom:1px solid var(--wb-line)}
.kicker{font:600 .7rem/1.2 var(--sl-font-mono);letter-spacing:.09em;color:var(--wb-gold);margin:0 0 .55rem}.workbench h1{font-size:clamp(1.65rem,3.7vw,2.55rem);line-height:1.08;letter-spacing:-.04em;margin:0;font-weight:650}.boundary{margin:0;color:var(--wb-muted);font-size:.78rem}.boundary span{color:var(--wb-gold)}
.definition{min-width:0;overflow:hidden;margin:1.35rem 0 1.15rem;background:#191a17;color:#ece9df;border:1px solid #34342e}.code-bar{display:flex;justify-content:space-between;padding:.55rem .85rem;border-bottom:1px solid #34342e;color:#aaa99e;font:.7rem var(--sl-font-mono)}.code-bar span:first-child{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.code-bar span:last-child{flex:none;padding-left:.75rem}.definition :global(pre){display:block;max-width:100%;min-width:0;box-sizing:border-box;padding:1rem 1.15rem;margin:0;overflow:auto;white-space:pre;font:.86rem/1.7 var(--sl-font-mono);tab-size:4}.definition :global(code){display:block;width:max-content;min-width:100%;color:#e8e3d4}.definition :global(code::selection){background:#786031}
.interface-nav{display:flex;border-bottom:1px solid var(--wb-line);gap:clamp(.7rem,3vw,2.5rem)}.interface-nav button{display:flex;align-items:baseline;gap:.5rem;min-height:2.8rem;padding:.55rem 0;border:0;border-bottom:2px solid transparent;margin-bottom:-1px;background:transparent;color:var(--wb-muted);font:600 .9rem var(--sl-font-mono);cursor:pointer}.interface-nav button[aria-selected=true]{border-color:var(--wb-gold);color:var(--wb-ink)}.interface-nav button>span{font-size:.65rem;color:var(--wb-gold)}.interface-nav small{font:normal .69rem var(--sl-font-sans);color:var(--wb-muted)}
.request{padding-top:1.25rem}.request-heading{display:flex;justify-content:space-between;align-items:start;gap:1rem}.request-heading .kicker{margin:0}.request-caption{margin:.3rem 0 .8rem;color:var(--wb-muted)}.request-heading a,.workbench-foot a{color:var(--wb-gold);text-decoration-thickness:1px;text-underline-offset:3px;font-size:.8rem}.request textarea{display:block;width:100%;max-width:100%;box-sizing:border-box;resize:vertical;padding:.85rem 1rem;border:1px solid var(--wb-line);border-radius:0;background:var(--wb-surface);color:var(--wb-ink);font:.84rem/1.55 var(--sl-font-mono)}.request textarea:focus-visible{outline:2px solid var(--wb-gold);outline-offset:2px}.actions{display:flex;align-items:center;flex-wrap:wrap;gap:.75rem;margin:.75rem 0}.actions button{min-height:2.75rem;padding:.55rem .9rem;font:600 .78rem var(--sl-font-sans);cursor:pointer}.run{background:var(--wb-gold);border:1px solid var(--wb-gold);color:#191a17}.run:hover{filter:brightness(1.08)}.reset{background:transparent;border:1px solid var(--wb-line);color:var(--wb-ink)}.actions #request-help{margin-left:auto;color:var(--wb-muted);font-size:.72rem}.error{color:var(--sl-color-red);min-height:0;margin:.3rem 0}.error:not(:empty){padding:.6rem;border:1px solid var(--sl-color-red)}
.result{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--wb-line);border-bottom:1px solid var(--wb-line);margin-top:.8rem}.result>div{min-width:0;padding:.85rem .9rem .85rem 0}.result>div+div{padding-left:.9rem;border-left:1px solid var(--wb-line)}.result-label{color:var(--wb-muted);font:600 .64rem var(--sl-font-mono);letter-spacing:.06em}.result pre{margin:.5rem 0 0;white-space:pre-wrap;overflow-wrap:anywhere;font:.78rem/1.55 var(--sl-font-mono)}.result ol{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:.2rem 1.8rem;border-top:1px solid var(--wb-line);margin:0;padding:.65rem 0 .65rem 1.2rem;color:var(--wb-muted);font-size:.72rem}
.workbench-foot{display:flex;justify-content:space-between;align-items:start;gap:1.5rem;padding-top:.9rem}.workbench-foot p{max-width:35rem;margin:0;color:var(--wb-muted);font-size:.7rem;line-height:1.55}.workbench-foot nav{display:flex;flex-wrap:wrap;gap:1rem;justify-content:end}.workbench-foot nav a{white-space:nowrap}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.workbench{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:2rem}
.workbench-head,.workbench-foot{grid-column:1/-1}
.definition{grid-column:1;grid-row:2 / span 2;align-self:start}
.definition :global(pre){border:0;border-radius:0}
.interface-nav{grid-column:2;grid-row:2;align-self:start;margin-top:1.35rem;gap:1.25rem}
.interface-nav button{margin:0;min-width:0;flex-wrap:wrap;justify-content:start}
.request{grid-column:2;grid-row:3;padding-top:1rem;min-width:0}
.actions button{margin:0}.actions #request-help{margin-left:0;flex-basis:100%}
.result{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
.result>div:nth-child(2){grid-column:1/-1;grid-row:1;border-left:0;padding-left:0;padding-bottom:1rem}
.result>div:first-child{grid-column:1;grid-row:2;border-top:1px solid var(--wb-line)}
.result>div:nth-child(3){grid-column:2;grid-row:2;border-top:1px solid var(--wb-line)}
.result pre{background:transparent;border:0;border-radius:0;padding:0;color:var(--wb-ink)}
.result #computed{font:500 1.3rem/1.4 var(--sl-font-sans);letter-spacing:-.025em}
.workbench-foot{margin-top:1.4rem;border-top:1px solid var(--wb-line)}
.workbench .result>div{margin:0}
:global([data-theme='light']) .run{color:#fff}
.workbench #computed{font-size:1.3rem}
@media(max-width:54rem){.workbench{display:block}.interface-nav{margin-top:0}}
@media(max-width:40rem){.result>div:first-child,.result>div:nth-child(2),.result>div:nth-child(3){grid-column:1;grid-row:auto}.result>div:nth-child(2){order:-1}.workbench-head{display:block;padding-bottom:.8rem}.workbench h1{font-size:1.72rem}.boundary{margin-top:.45rem;font-size:.7rem}.definition{margin:.85rem 0}.definition pre{padding:.75rem;font-size:.74rem}.interface-nav{justify-content:space-between;gap:.3rem}.interface-nav button{gap:.32rem;font-size:.78rem}.request{padding-top:.85rem}.result{grid-template-columns:1fr}.result>div{padding:.65rem 0}.result>div+div{padding:.65rem 0;border-left:0;border-top:1px solid var(--wb-line)}.result ol{grid-column:1}.workbench-foot{display:block}.workbench-foot nav{justify-content:start;margin-top:.7rem;gap:.75rem}.actions #request-help{flex-basis:100%;margin-left:0}}
@media(prefers-reduced-motion:reduce){.workbench *, .workbench *::before, .workbench *::after{scroll-behavior:auto!important;animation-duration:.01ms!important;transition-duration:.01ms!important}}
:global(.content-panel:has(> .sl-container > h1#_top)){display:none}
</style>
