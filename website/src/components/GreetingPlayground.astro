---
import { functionDefinition } from '../lib/greeting-playground.mjs';
---
<section class="playground" aria-labelledby="greeting-playground-title">
  <header class="intro">
    <p class="eyebrow">Browser-local interface previews · no Python runtime</p>
    <h2 id="greeting-playground-title">One typed function, three interfaces</h2>
    <p>Edit a CLI command, HTTP request, or MCP tool call below. Preview how each maps to the same typed arguments and result.</p>
  </header>
  <div class="setup">
  <div class="definition"><span>Shared typed function · shipped Intpot example</span><pre>{functionDefinition}</pre></div>
  <div class="shared">
    <label>Name for draft requests <input id="shared-name" maxlength="40" value="Ada" /></label>
    <label class="toggle"><input id="shared-excited" type="checkbox" /> Excited</label>
    <button type="button" id="fill-drafts">Fill all request drafts</button>
    <button type="button" id="reset-all">Reset results</button>
  </div>
  </div>
  <div class="panels">
    {['CLI', 'HTTP', 'MCP'].map((kind) => <article class="panel" data-interface={kind}>
      <h3>{kind === 'HTTP' ? 'HTTP API' : kind}</h3>
      <p class="note">{kind === 'CLI' ? 'Bounded command preview · quoted positional name' : kind === 'HTTP' ? 'Request preview · POST /greet' : 'Request preview · MCP tool call'}</p>
      <p class="adapter">Python adapter: <code>{kind === 'CLI' ? 'Typer' : kind === 'HTTP' ? 'FastAPI' : 'FastMCP'}</code></p>
      <label for={`request-${kind}`}>Editable request</label>
      <textarea id={`request-${kind}`} maxlength="512" rows={kind === 'CLI' ? 2 : 6} spellcheck="false"></textarea>
      <button type="button" class="run">Preview request</button>
      <p class="error" role="alert"></p>
      <div class="outcome" aria-live="polite"><strong>Computed result</strong><pre class="result">Not run</pre><strong>Response shape</strong><pre class="response">—</pre><strong>Trace</strong><ol class="trace"><li>Waiting for an explicit local run</li></ol></div>
    </article>)}
  </div>
  <p class="honest">These are browser-local previews of request parsing and function behavior. They do not launch Intpot, Python adapters, HTTP requests, MCP clients, a backend, or a model.</p>
  <p class="links"><a href="https://github.com/tugrulguner/intpot/blob/main/examples/semantic_schema.py">View the Python example</a> · <a href="/quickstart/">Run real Intpot locally</a> · <a href="/capabilities/">Capabilities</a></p>
</section>
<script>
  import { defaultRequests, runRequest } from '../lib/greeting-playground.mjs';
  const panels = [...document.querySelectorAll<HTMLElement>('.panel')];
  const drafts = defaultRequests();
  for (const panel of panels) {
    const kind = panel.dataset.interface!;
    const input = panel.querySelector<HTMLTextAreaElement>('textarea')!;
    input.value = drafts[kind as keyof typeof drafts];
    const error = panel.querySelector<HTMLElement>('.error')!;
    const clear = () => { error.textContent = ''; panel.querySelector('.result')!.textContent = 'Not run'; panel.querySelector('.response')!.textContent = '—'; panel.querySelector('.trace')!.innerHTML = '<li>Request edited; run again to compute a fresh result</li>'; };
    input.addEventListener('input', clear);
    panel.querySelector<HTMLButtonElement>('.run')!.addEventListener('click', () => {
      clear();
      try {
        const computed = runRequest(kind, input.value);
        panel.querySelector('.result')!.textContent = computed.result;
        panel.querySelector('.response')!.textContent = typeof computed.response === 'string' ? computed.response : JSON.stringify(computed.response, null, 2);
        const trace = panel.querySelector<HTMLOListElement>('.trace')!;
        trace.replaceChildren(...computed.trace.map((line) => { const li = document.createElement('li'); li.textContent = line; return li; }));
      } catch (cause) { error.textContent = cause instanceof Error ? cause.message : 'Invalid request.'; }
    });
  }
  document.querySelector<HTMLButtonElement>('#fill-drafts')!.addEventListener('click', () => {
    const name = (document.querySelector<HTMLInputElement>('#shared-name')!).value;
    const excited = document.querySelector<HTMLInputElement>('#shared-excited')!.checked;
    const values = defaultRequests(name, excited);
    for (const panel of panels) { (panel.querySelector('textarea') as HTMLTextAreaElement).value = values[panel.dataset.interface as keyof typeof values]; panel.querySelector('textarea')!.dispatchEvent(new Event('input')); }
  });
  document.querySelector<HTMLButtonElement>('#reset-all')!.addEventListener('click', () => {
    for (const panel of panels) { panel.querySelector('.error')!.textContent = ''; panel.querySelector('.result')!.textContent = 'Not run'; panel.querySelector('.response')!.textContent = '—'; panel.querySelector('.trace')!.innerHTML = '<li>Waiting for an explicit local run</li>'; }
  });
</script>
<style>
.playground{color:var(--sl-color-text);max-width:76rem}.intro{max-width:54rem}.intro h2{font-size:clamp(1.5rem,3vw,2.2rem);margin:.25rem 0}.intro p{line-height:1.55}.eyebrow{color:var(--sl-color-accent);font-weight:700;text-transform:uppercase;font-size:.78rem;letter-spacing:.06em}.definition,.panel,.shared{border:1px solid var(--sl-color-gray-5);border-radius:.7rem;padding:1rem;background:var(--sl-color-bg)}.definition{margin:1rem 0}.definition span,.outcome strong{font-size:.8rem;font-weight:700;color:var(--sl-color-accent)}pre{white-space:pre-wrap;overflow-wrap:anywhere;overflow:auto}.definition pre{margin:.5rem 0 0}.shared{display:flex;align-items:end;gap:.75rem;flex-wrap:wrap;margin-bottom:1rem}.shared label{display:grid;gap:.3rem;font-weight:600}.shared input:not([type=checkbox]){width:min(20rem,70vw)}.toggle{display:flex!important;align-items:center;min-height:2.5rem}.panels{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.8rem}.panel{min-width:0}.panel h3{margin:0}.note{font-size:.84rem;min-height:2.5em;color:var(--sl-color-gray-2)}.panel label{font-weight:650}.panel textarea{display:block;width:100%;box-sizing:border-box;resize:vertical;margin:.4rem 0 .6rem;padding:.65rem;border:1px solid var(--sl-color-gray-5);border-radius:.4rem;background:var(--sl-color-bg);color:var(--sl-color-text);font: .86rem/1.45 ui-monospace,monospace}.panel button,.shared button{min-height:2.6rem;border:1px solid var(--sl-color-accent);border-radius:.4rem;background:transparent;color:inherit;padding:.5rem .75rem;font:inherit;font-weight:650;cursor:pointer}.panel button:hover,.shared button:hover{background:var(--sl-color-accent-low)}.outcome{border-top:1px solid var(--sl-color-gray-5);margin-top:.8rem;padding-top:.75rem}.outcome pre{margin:.25rem 0 .65rem;font-size:.85rem;min-height:1.3em}.trace{padding-left:1.3rem;font-size:.82rem}.error{min-height:1.2em;color:var(--sl-color-red);font-size:.85rem}.honest{border-left:3px solid var(--sl-color-accent);padding:.5rem .75rem;line-height:1.5}.links{font-size:.9rem}@media(max-width:58rem){.panels{grid-template-columns:1fr}.note{min-height:0}.shared{align-items:stretch}.shared label{flex:1 1 12rem}}
</style>
<style>
  .setup { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: .8rem; margin-block: 1rem; }
  .setup > .definition, .setup > .shared { margin: 0; min-width: 0; }
  .setup > .shared { flex-direction: row; align-items: center; align-content: center; justify-content: flex-start; }
  .setup .shared > * { margin: 0; }
  .setup .shared label { flex: 1 1 100%; }
  .setup .shared .toggle { flex: 1 1 100%; }
  .setup .shared input:not([type='checkbox']) { max-width: 100%; }
  .adapter { font-size: .8rem; margin-block: .3rem; }
  .panels > .panel { margin: 0; }
  @media (max-width: 40rem) { .setup { grid-template-columns: minmax(0, 1fr); } }
  .shared input:not([type='checkbox']) { min-height: 2.75rem; box-sizing: border-box; padding: .5rem .65rem; border: 1px solid var(--sl-color-gray-5); border-radius: .4rem; background: var(--sl-color-bg); color: var(--sl-color-text); font: inherit; }
  .shared input[type='checkbox'] { accent-color: var(--sl-color-accent); }
  .definition pre { padding: .65rem; font-size: .82rem; line-height: 1.45; }
  .intro p { margin-block: .5rem; }
  .shared button, .panel button { min-height: 2.75rem; }
</style>
