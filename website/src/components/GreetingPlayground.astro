---
import { Code } from 'astro:components';
import { functionDefinition } from '../lib/greeting-playground.mjs';
const codeTheme = {
  name: 'intpot-charcoal', type: 'dark' as const,
  colors: { 'editor.background': '#202226', 'editor.foreground': '#edeff2' },
  tokenColors: [
    { scope: ['keyword', 'storage', 'entity.name.function'], settings: { foreground: '#dfbd72' } },
    { scope: ['string'], settings: { foreground: '#e9e4d9' } },
    { scope: ['comment'], settings: { foreground: '#b4b7bb' } },
    { scope: ['constant', 'support.type'], settings: { foreground: '#ece9e2' } },
  ],
};
---
<section class="workbench" aria-labelledby="playground-title" data-playground>
  <header class="workbench-head"><div><p class="kicker">INTPOT · PLAYGROUND</p><h1 id="playground-title">One definition. Three ways in.</h1></div><p class="boundary">Browser-local preview <span>·</span> Python adapters do not run here</p></header>
  <section class="definition panel" aria-label="Canonical typed Python definition"><div class="panel-heading"><span>01 / CODE</span><span class="code-file">examples/semantic_schema.py · Python</span></div><Code code={functionDefinition} lang="python" theme={codeTheme} /></section>
  <section class="run-panel panel" aria-label="Run a browser-local preview"><div class="panel-heading"><span>02 / RUN</span><span class="code-file">Choose an interface</span></div><div class="interface-nav" role="tablist" aria-label="Choose an interface"><button type="button" role="tab" id="tab-CLI" aria-controls="interface-panel" aria-selected="true" data-kind="CLI"><span>CLI</span><small>Typer</small></button><button type="button" role="tab" id="tab-HTTP" aria-controls="interface-panel" aria-selected="false" tabindex="-1" data-kind="HTTP"><span>HTTP</span><small>FastAPI</small></button><button type="button" role="tab" id="tab-MCP" aria-controls="interface-panel" aria-selected="false" tabindex="-1" data-kind="MCP"><span>MCP</span><small>FastMCP</small></button></div>
  <article class="request" id="interface-panel" role="tabpanel" aria-labelledby="tab-CLI"><div class="request-heading"><div><p class="kicker" id="interface-label">CLI · REQUEST</p><p class="request-caption" id="request-caption">A command passes a name and its typed options.</p></div><a href="https://github.com/tugrulguner/intpot/blob/main/examples/semantic_schema.py">Source ↗</a></div><label class="sr-only" for="request">Editable interface request</label><textarea id="request" maxlength="512" rows="4" spellcheck="false" aria-describedby="request-help"></textarea><div class="actions"><button type="button" class="run" id="run-request">Run local preview <span aria-hidden="true">↗</span></button><button type="button" class="reset" id="reset-request">Reset</button><span id="request-help">Edits never execute automatically.</span></div><p class="error" role="alert" aria-live="polite"></p></article></section>
  <section class="inspector panel" aria-label="Output inspection"><div class="panel-heading"><span>03 / OUTPUT</span><span class="code-file">Local result</span></div><div class="output-nav" role="tablist" aria-label="Output views"><button role="tab" id="output-tab-result" aria-label="Result" aria-controls="output-panel" aria-selected="true" tabindex="0">Result</button><button role="tab" id="output-tab-arguments" aria-label="Typed arguments" aria-controls="output-panel" aria-selected="false" tabindex="-1">Args</button><button role="tab" id="output-tab-response" aria-label="Interface response" aria-controls="output-panel" aria-selected="false" tabindex="-1">Response</button><button role="tab" id="output-tab-trace" aria-label="Request trace" aria-controls="output-panel" aria-selected="false" tabindex="-1">Trace</button></div><div id="output-panel" role="tabpanel" aria-labelledby="output-tab-result" tabindex="0" aria-live="polite"><div class="output-view" data-view="result"><span class="result-label">RESULT</span><pre id="computed">Not run</pre></div><div class="output-view" data-view="arguments" hidden><span class="result-label">TYPED ARGUMENTS</span><pre id="arguments">Not run</pre></div><div class="output-view" data-view="response" hidden><span class="result-label">INTERFACE RESPONSE</span><pre id="response">Not run</pre></div><div class="output-view" data-view="trace" hidden><span class="result-label">REQUEST TRACE</span><ol id="trace"><li>Choose a request and run its browser-local preview.</li></ol></div></div></section>
  <footer class="workbench-foot"><p>Runs a bounded JavaScript preview of request parsing and function behavior—not Python, Typer, FastAPI, FastMCP, a server, or a model.</p><nav aria-label="Intpot resources"><a href="/quickstart/">Run real Intpot locally →</a><a href="/capabilities/">Docs</a><a href="https://github.com/tugrulguner/intpot">GitHub ↗</a><a href="https://modepot.io/">ModePot ↗</a></nav></footer>
</section>
<script>
import { defaultRequests, runRequest } from '../lib/greeting-playground.mjs';
const root = document.querySelector<HTMLElement>('[data-playground]')!;
const input = root.querySelector<HTMLTextAreaElement>('#request')!;
const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')].filter((tab) => tab.dataset.kind);
const outputTabs = [...root.querySelectorAll<HTMLButtonElement>('.output-nav [role="tab"]')];
const outputViews = [...root.querySelectorAll<HTMLElement>('.output-view')];
const selectOutput = (tab: HTMLButtonElement, focus = false) => {
  outputTabs.forEach((item) => { const selected = item === tab; item.setAttribute('aria-selected', String(selected)); item.tabIndex = selected ? 0 : -1; });
  outputViews.forEach((view) => { view.hidden = view.dataset.view !== tab.id.replace('output-tab-', ''); });
  root.querySelector<HTMLElement>('#output-panel')!.setAttribute('aria-labelledby', tab.id);
  if (focus) tab.focus();
};
outputTabs.forEach((tab, index) => {
  tab.addEventListener('click', () => selectOutput(tab));
  tab.addEventListener('keydown', (event) => {
    if (!['ArrowRight', 'ArrowLeft', 'Home', 'End'].includes(event.key)) return;
    event.preventDefault(); const next = event.key === 'Home' ? 0 : event.key === 'End' ? outputTabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : outputTabs.length - 1)) % outputTabs.length;
    selectOutput(outputTabs[next], true);
  });
});
let active: 'CLI' | 'HTTP' | 'MCP' = 'CLI';
const defaults = defaultRequests(); input.value = defaults.CLI;
const clear = (message = 'Choose a request and run its browser-local preview.') => {
  root.querySelector<HTMLElement>('.error')!.textContent = '';
  for (const id of ['arguments', 'computed', 'response']) root.querySelector(`#${id}`)!.textContent = 'Not run';
  const li = document.createElement('li'); li.textContent = message;
  root.querySelector<HTMLOListElement>('#trace')!.replaceChildren(li);
};
const select = (kind: 'CLI' | 'HTTP' | 'MCP', focus = false) => {
  active = kind;
  tabs.forEach((tab) => { const selected = tab.dataset.kind === kind; tab.setAttribute('aria-selected', String(selected)); tab.tabIndex = selected ? 0 : -1; });
  const tab = root.querySelector<HTMLButtonElement>(`#tab-${kind}`)!;
  root.querySelector<HTMLElement>('#interface-panel')!.setAttribute('aria-labelledby', tab.id);
  root.querySelector<HTMLElement>('#interface-label')!.textContent = `${kind === 'HTTP' ? 'HTTP API' : kind} · REQUEST`;
  root.querySelector<HTMLElement>('#request-caption')!.textContent = kind === 'CLI' ? 'A command passes a name and its typed options.' : kind === 'HTTP' ? 'POST /greet sends a JSON request body.' : 'A greet tool call passes typed arguments.';
  input.value = defaults[kind]; clear(); if (focus) input.focus();
};
tabs.forEach((tab, index) => {
  tab.addEventListener('click', () => select(tab.dataset.kind as typeof active));
  tab.addEventListener('keydown', (event) => {
    if (!['ArrowRight', 'ArrowLeft', 'Home', 'End'].includes(event.key)) return;
    event.preventDefault(); const next = event.key === 'Home' ? 0 : event.key === 'End' ? 2 : (index + (event.key === 'ArrowRight' ? 1 : 2)) % 3;
    select(tabs[next].dataset.kind as typeof active, true); tabs[next].focus();
  });
});
input.addEventListener('input', () => clear('Request edited; run again to compute a fresh result.'));
root.querySelector<HTMLButtonElement>('#run-request')!.addEventListener('click', () => {
  clear();
  try {
    const output = runRequest(active, input.value);
    root.querySelector('#arguments')!.textContent = JSON.stringify(output.args);
    root.querySelector('#computed')!.textContent = output.result;
    root.querySelector('#response')!.textContent = typeof output.response === 'string' ? output.response : JSON.stringify(output.response, null, 2);
    root.querySelector<HTMLOListElement>('#trace')!.replaceChildren(...output.trace.map((line) => { const li = document.createElement('li'); li.textContent = line; return li; }));
  } catch (cause) { root.querySelector<HTMLElement>('.error')!.textContent = cause instanceof Error ? cause.message : 'Invalid request.'; }
});
root.querySelector<HTMLButtonElement>('.reset')!.addEventListener('click', () => { input.value = defaults[active]; clear(); });
</script>
<style>
.workbench{--wb-bg:#f8f7f4;--wb-surface:#fff;--wb-ink:#181a1d;--wb-muted:#626970;--wb-line:#d9d7d1;--wb-gold:#795711;max-width:78rem;color:var(--wb-ink);background:var(--wb-bg);font-size:14px}
:global(:root[data-theme='dark']) .workbench{--wb-bg:#16181b;--wb-surface:#202226;--wb-ink:#edeff2;--wb-muted:#aeb4bc;--wb-line:#41444a;--wb-gold:#dfbd72}
.workbench a{color:var(--wb-gold)}
.workbench-head{display:flex;align-items:end;justify-content:space-between;gap:1rem;padding:0 0 1.15rem;border-bottom:1px solid var(--wb-line)}
.kicker{font:600 13px/1.2 var(--sl-font-mono);letter-spacing:.02em;color:var(--wb-gold);margin:0 0 .55rem}.workbench h1{font-size:clamp(1.65rem,3.7vw,2.55rem);line-height:1.08;letter-spacing:-.04em;margin:0;font-weight:650}.boundary{margin:0;color:var(--wb-muted);font-size:.78rem}.boundary span{color:var(--wb-gold)}
.definition{min-width:0;overflow:hidden;margin:1.35rem 0 1.15rem;background:#202226;color:#edeff2;border:1px solid #41444a}.code-bar{display:flex;justify-content:space-between;padding:.55rem .85rem;border-bottom:1px solid #41444a;color:#b4b4b1;font:.7rem var(--sl-font-mono)}.code-bar span:first-child{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.code-bar span:last-child{flex:none;padding-left:.75rem}.definition :global(pre){display:block;max-width:100%;min-width:0;box-sizing:border-box;padding:1rem 1.15rem;margin:0;overflow:auto;white-space:pre;font:12.5px/1.7 var(--sl-font-mono);tab-size:4}.definition :global(code){display:block;width:max-content;min-width:100%;color:#edeff2}.definition :global(code::selection){background:#6c562b}
.interface-nav{display:flex;border-bottom:1px solid var(--wb-line);gap:clamp(.7rem,3vw,2.5rem)}.interface-nav button{display:flex;align-items:baseline;gap:.5rem;min-height:2.8rem;padding:.55rem 0;border:0;border-bottom:2px solid transparent;margin-bottom:-1px;background:transparent;color:var(--wb-muted);font:600 .9rem var(--sl-font-mono);cursor:pointer}.interface-nav button[aria-selected=true]{border-color:var(--wb-gold);color:var(--wb-ink)}.interface-nav button>span{font-size:.65rem;color:var(--wb-gold)}.interface-nav small{font:normal .69rem var(--sl-font-sans);color:var(--wb-muted)}
.request{padding-top:1.25rem}.request-heading{display:flex;justify-content:space-between;align-items:start;gap:1rem}.request-heading .kicker{margin:0}.request-caption{margin:.3rem 0 .8rem;color:var(--wb-muted)}.request-heading a,.workbench-foot a{color:var(--wb-gold);text-decoration-thickness:1px;text-underline-offset:3px;font-size:13px}.request textarea{display:block;width:100%;max-width:100%;box-sizing:border-box;resize:vertical;padding:.85rem 1rem;border:1px solid var(--wb-line);border-radius:0;background:var(--wb-surface);color:var(--wb-ink);font:12.5px/1.55 var(--sl-font-mono)}.request textarea:focus-visible{outline:2px solid var(--wb-gold);outline-offset:2px}.actions{display:flex;align-items:center;flex-wrap:wrap;gap:.75rem;margin:.75rem 0}.actions button{height:44px;min-height:44px;padding:0 .9rem;font:600 14px/1 var(--sl-font-sans);cursor:pointer}.run{background:var(--wb-gold);border:1px solid var(--wb-gold);color:#fff}.run:hover{filter:brightness(1.08)}.reset{background:transparent;border:1px solid var(--wb-line);color:var(--wb-ink)}.actions #request-help{margin-left:0;flex-basis:100%;color:var(--wb-muted);font-size:13px}.error{color:#a4262b;min-height:0;margin:.3rem 0}.error:not(:empty){padding:.6rem;border:1px solid currentColor}:global(:root[data-theme='dark']) .error{color:#ff9b9b}
:global(:root[data-theme='dark']) .run{color:#181a1d}
 .result-label{color:var(--wb-muted);font:600 13px/1.4 var(--sl-font-mono)}
.workbench-foot{display:flex;justify-content:space-between;align-items:start;gap:1.5rem;padding-top:.9rem}.workbench-foot p{max-width:35rem;margin:0;color:var(--wb-muted);font-size:13px;line-height:1.55}.workbench-foot nav{display:flex;flex-wrap:wrap;gap:1rem;justify-content:end}.workbench-foot nav a{white-space:nowrap}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.workbench{display:grid;grid-template-columns:minmax(0,1.2fr) repeat(2,minmax(0,1fr));column-gap:1rem;align-items:stretch}
.workbench-head,.workbench-foot{grid-column:1/-1}
.panel{box-sizing:border-box;min-width:0;height:420px;margin:1rem 0 0;border:1px solid var(--wb-line);background:var(--wb-surface);overflow:hidden}
.panel-heading{flex-shrink:0;height:46px;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;gap:.5rem;padding:0 .8rem;border-bottom:1px solid var(--wb-line);background:color-mix(in srgb,var(--wb-surface) 84%,var(--wb-ink) 16%);color:var(--wb-ink);font:650 12px/1.2 var(--sl-font-mono);letter-spacing:.035em}
.definition.panel{background:#202226}
.code-file{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--wb-muted);font-weight:400;letter-spacing:0}
.definition :global(pre){box-sizing:border-box;width:100%;min-width:0;max-height:370px;overflow:auto;white-space:pre;font-size:12px;line-height:1.65;padding:.85rem .65rem}
.definition :global(code){width:max-content;min-width:100%}
.run-panel{display:flex;flex-direction:column}
.interface-nav{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.4rem;padding:.7rem .65rem .5rem;border-bottom:1px solid var(--wb-line)}
.interface-nav button{box-sizing:border-box;display:flex;min-width:0;min-height:44px;margin:0;padding:.3rem .18rem;align-items:center;justify-content:center;gap:.25rem;flex-wrap:wrap;border:1px solid var(--wb-line);border-radius:3px;background:var(--wb-bg);color:var(--wb-ink);font:650 13px/1.2 var(--sl-font-sans);cursor:pointer}
.interface-nav button[aria-selected=true],.output-nav button[aria-selected=true]{border:2px solid var(--wb-gold);background:#f0dfba;color:#181a1d}
:global(:root[data-theme='dark']) .interface-nav button[aria-selected=true],:global(:root[data-theme='dark']) .output-nav button[aria-selected=true]{background:#4d422c;color:#edeff2}
.interface-nav small{font:500 10px/1.2 var(--sl-font-sans);color:var(--wb-muted)}
.request{padding:.75rem .75rem 0;min-width:0;margin:0;overflow:auto}
.request p{margin-top:0}.request-caption{margin:.3rem 0 .6rem;color:var(--wb-muted);line-height:1.4}
.request textarea{min-height:7.4rem;resize:vertical;line-height:1.5;margin:0}
.actions{margin:.65rem 0}.actions button{margin:0}
.request-heading a{white-space:nowrap}
.run{background:#795711;border:1px solid #795711;color:#fff}
:global(:root[data-theme='dark']) .run{background:#dfbd72;border-color:#dfbd72;color:#181a1d}
.inspector{display:flex;flex-direction:column}
.output-nav{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.25rem;padding:.55rem .55rem;border-bottom:1px solid var(--wb-line)}
.output-nav button{box-sizing:border-box;min-width:0;height:44px;min-height:44px;margin:0;padding:.35rem .12rem;border:1px solid var(--wb-line);border-radius:3px;background:var(--wb-bg);color:var(--wb-ink);font:600 12px/1.2 var(--sl-font-sans);cursor:pointer;text-align:center;white-space:nowrap}

.inspector #output-panel{box-sizing:border-box;flex:1;min-height:0;overflow:auto;padding:.8rem .85rem;overscroll-behavior:contain}
.output-view[hidden]{display:none}
.inspector pre{max-height:16rem;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;margin:.35rem 0 0;padding:0;border:0;border-radius:0;background:transparent;color:var(--wb-ink);font:13px/1.5 var(--sl-font-mono)}
.inspector ol{max-height:16rem;overflow:auto;padding-left:1.2rem;color:var(--wb-muted);font-size:13px;line-height:1.5;overflow-wrap:anywhere;margin:.35rem 0 0}
.inspector #computed{font:500 21px/1.4 var(--sl-font-sans)}
.workbench-foot{margin-top:1.4rem;border-top:1px solid var(--wb-line)}
.panel-heading .code-file{flex:0 1 58%;text-align:right}
@media(max-width:68rem){.workbench{grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:1rem}.definition{grid-column:1;grid-row:2;}.run-panel{grid-column:2;grid-row:2}.inspector{grid-column:1/-1;grid-row:3;height:340px;margin-top:0}.definition,.run-panel{height:420px}.workbench-foot{margin-top:1rem}}
@media(max-width:40rem){.workbench{display:block}.workbench-head{display:block;padding-bottom:.8rem}.workbench h1{font-size:1.72rem}.boundary{margin-top:.45rem;font-size:13px}.panel,.definition,.run-panel,.inspector{height:auto;min-height:0;margin:.75rem 0 0}.definition :global(pre){max-height:none;white-space:pre-wrap;overflow-wrap:anywhere;padding:.75rem;font-size:12px}.definition :global(code){width:auto;min-width:0}.interface-nav{gap:.25rem;padding:.55rem .45rem}.interface-nav button{flex-direction:column;gap:.15rem;font-size:12px}.request{padding:.65rem .65rem 0}.request textarea{min-height:7rem}.inspector{min-height:230px}.inspector #output-panel{min-height:100px}.inspector pre,.inspector ol{max-height:9rem}.panel-heading{padding-inline:.6rem;font-size:11px}.output-nav{gap:.2rem;padding:.45rem .35rem}.output-nav button{font-size:11px;padding-inline:.1rem}.workbench-foot{display:block;margin-top:1rem}.workbench-foot nav{justify-content:start;margin-top:.7rem;gap:.75rem}}
@media(prefers-reduced-motion:reduce){.workbench *, .workbench *::before, .workbench *::after{scroll-behavior:auto!important;animation-duration:.01ms!important;transition-duration:.01ms!important}}
:global(.content-panel:has(> .sl-container > h1#_top)){display:none}
</style>
